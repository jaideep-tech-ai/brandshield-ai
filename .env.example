# ─── BrandShield AI — environment template ───────────────────────────────────
# Copy to .env.local (local dev) or set in your hosting provider (production).
# NEVER commit real .env files.

# Database (SQLite locally; PostgreSQL in production)
DATABASE_URL="file:./db/custom.db"

# Session cookie signing secret (generate: openssl rand -base64 48)
SESSION_SECRET=""

# ─── Firebase Authentication (optional — activates Firebase mode) ────────────
# Without these the app runs in local auth mode with identical semantics.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Server-side project id for Firebase ID token verification (RS256)
FIREBASE_PROJECT_ID=""

# ─── Optional: AI provider for vision/tone scan stages ───────────────────────
# ZAI_BASE_URL=""
# ZAI_API_KEY=""

# ─── GitLab Self-Service Integration & OAuth 2.0 (Optional) ───────────────────
# Create an OAuth Application in GitLab (User Settings -> Applications or Group -> Applications)
# Redirect URI: https://<your-domain>/api/integrations/gitlab/callback
# Scopes: api, read_user
# GITLAB_CLIENT_ID=""
# GITLAB_CLIENT_SECRET=""
# GITLAB_REDIRECT_URI=""
# GITLAB_OAUTH_SCOPES="api read_user"
# GITLAB_ACCESS_TOKEN="" # Optional server fallback PAT for administrative automation
# GITLAB_WEBHOOK_SECRET="" # Optional fallback default webhook secret


