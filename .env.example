# ─── BrandShield AI — environment template ───────────────────────────────────
# Copy to .env.local (local dev) or set in your hosting provider (production).
# NEVER commit real .env files.

# Database (SQLite locally; PostgreSQL in production)
DATABASE_URL="file:./db/custom.db"

# Session cookie signing secret (generate: openssl rand -base64 48)
SESSION_SECRET=""

# ─── Firebase Authentication (optional — activates Firebase mode) ────────────
# Without these the app runs in local auth mode with identical semantics.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Server-side project id for Firebase ID token verification (RS256)
FIREBASE_PROJECT_ID=""

# ─── Optional: AI provider for vision/tone scan stages ───────────────────────
# ZAI_BASE_URL=""
# ZAI_API_KEY=""

# ─── Optional: GitLab Webhook & Commit Status API Integration ────────────────
# GITLAB_ACCESS_TOKEN=""
# GITLAB_WEBHOOK_SECRET=""
# GITLAB_ORG_SLUG="nimbus-labs"

