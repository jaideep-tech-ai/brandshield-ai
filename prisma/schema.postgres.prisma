// ─── Multi-tenant Organizations ───────────────────────────────────────────────

model Organization {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  zeroDataRetention Boolean @default(true)
  createdAt        DateTime @default(now())
  users            User[]
  guidelines       GuidelineDocument[]
  visualTokens     VisualToken[]
  submissions      Submission[]
  auditLogs        AuditLog[]
  subscription     Subscription?
  visualInspections VisualInspection[]
  chatSessions     GovernanceChatSession[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  password     String   @default("demo1234") // salted scrypt hash (scrypt$N$r$p$salt$hash) — never plaintext in production paths
  firebaseUid  String?  @unique // links a Federated (Firebase Auth) identity; unique = one Firebase account can never fork duplicates
  role         String // creator | reviewer | contractor | admin
  department   String?
  orgName      String?
  avatarColor  String   @default("#0F766E")
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  submissions  Submission[]
  auditLogs    AuditLog[]
  revisions    Revision[]
  visualInspections VisualInspection[]
  chatSessions GovernanceChatSession[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([orgId])
  @@index([role])
}

